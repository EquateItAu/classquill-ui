{
  "name": "@classquill/ui",
  "version": "0.1.0",
  "description": "Shared design system, brand, and SEO primitives for classquill.com (marketing) and app.classquill.com (product) — presentational only, no auth/data-layer code.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check:dist": "npm run build && git diff --exit-code dist/"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.12.0"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^2.0.0",
    "@hugeicons/react": "^1.1.1",
    "@sentry/react": "10.60.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "flag-icons": "^7.5.0",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^0.561.0",
    "posthog-js": "^1.314.0",
    "radix-ui": "^1.4.3",
    "react-helmet-async": "^2.0.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.12.0",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
